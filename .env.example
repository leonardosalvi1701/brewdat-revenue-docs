# Modelo do .env. O .env nao vai para o git.
#
# O jeito normal de criar o .env e rodar scripts/preparar_ambiente.sh, que
# copia este arquivo. O perfil do Databricks e configurado em settings.yaml. Autenticacao nao usa
# segredo: o DevOps vem do `az login` e o Databricks do login SSO da CLI.

# ---- Azure DevOps ----
# So preencha AZDO_PAT se voce nao tem o `az` na maquina, ou se roda isto sem
# sessao interativa. Precisa apenas de permissao de leitura de Work Items.
# Estando preenchido, ele tem precedencia sobre o `az login`.
AZDO_PAT=

# Sobrescrevem config/settings.yaml. Uteis para apontar para outro time sem
# editar arquivo versionado.
# AZDO_ORG_URL=https://dev.azure.com/AMBEV-SA
# AZDO_PROJECT=AMBEV-ANALYTICS-DATA-CHAPTER-SALES
# AZDO_TEAM=Squad Revenue DI

# O script de preparacao preenche com usuarios.devops_email de
# config/settings.yaml; docs config-check compara esse valor com a identidade
# que o Azure DevOps devolve.
AZDO_USER_EMAIL=

# ---- GitHub (opcional: evidencia de commit na review) ----
# O login associado a este token e conferido com usuarios.github em
# config/settings.yaml por docs config-check.
GITHUB_TOKEN=
GITHUB_ORG=BrewDat

# ---- Databricks (inventario de notebooks) ----
# Workspace da squad.
DATABRICKS_HOST=https://adb-1820723078635205.5.azuredatabricks.net
# O nome do perfil SSO e mantido em databricks.perfil no config/settings.yaml.
# O script de preparacao cria/autentica exatamente esse perfil.

# ---- Provedor de LLM (agentes) ----
# Preencher so o do agente em uso. O harness costuma cuidar da credencial
# sozinho; estas variaveis existem para quem chama a API direto.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
