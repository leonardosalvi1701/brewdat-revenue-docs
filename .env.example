# Copiar para .env SO SE voce precisar de algum dos casos abaixo. O .env nao
# vai para o git.
#
# Para ler os seus cards e escrever a sua sprint review, voce nao precisa de
# nada aqui: `az login` resolve a autenticacao, e o endereco do board esta em
# config/settings.yaml, igual para toda a squad.

# ---- Azure DevOps ----
# So preencha AZDO_PAT se voce nao tem o `az` na maquina, ou se roda isto sem
# sessao interativa. Precisa apenas de permissao de leitura de Work Items.
# Estando preenchido, ele tem precedencia sobre o `az login`.
AZDO_PAT=

# Sobrescrevem config/settings.yaml. Uteis para apontar para outro time sem
# editar arquivo versionado.
# AZDO_ORG_URL=https://dev.azure.com/AMBEV-SA
# AZDO_PROJECT=AMBEV-ANALYTICS-DATA-CHAPTER-SALES
# AZDO_TEAM=Squad Revenue DI

# Quem voce e no DevOps. Em branco, `--meus` descobre pela sua credencial, que
# e o caminho normal. Preencher so se a deteccao falhar; confira o valor exato
# com `docs quem-sou-eu`.
AZDO_USER_EMAIL=

# ---- GitHub (opcional: evidencia de commit na review) ----
GITHUB_TOKEN=
GITHUB_ORG=BrewDat

# ---- Databricks (opcional: inventario de notebooks) ----
DATABRICKS_HOST=https://adb-XXXX.azuredatabricks.net
DATABRICKS_TOKEN=

# ---- Provedor de LLM (agentes) ----
# Preencher so o do agente em uso. O harness costuma cuidar da credencial
# sozinho; estas variaveis existem para quem chama a API direto.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
