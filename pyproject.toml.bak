[project]
name = "docsquad"
version = "0.1.0"
description = "Documentacao assistida da squad Revenue: DevOps, GitHub e Databricks sob portao de validacao humana"
requires-python = ">=3.10"
dependencies = [
    "requests>=2.31",
    "pyyaml>=6.0",
    "python-dotenv>=1.0",
    "typer>=0.12",
    "rich>=13.7",
]

[project.scripts]
docs = "docsquad.cli:app"

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["src"]
